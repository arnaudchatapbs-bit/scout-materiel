# Copier ce fichier en .env et adapter les valeurs (jamais commité).
# Sur le Pi : voir DEPLOIEMENT.md. Sur le PC de développement : voir README.md.

# --- Application ---
# Générer une clé : openssl rand -base64 48
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
# true sur le PC de développement, false sur le Pi
DEBUG=true
# Port local de l'application (Caddy lui transmet /api/)
PORT=8000

# --- Mots de passe (Pi) ---
# Vide = 600 000 itérations : plusieurs secondes par connexion sur un Pi 1, site bloqué pendant ce temps.
# Sur le Pi, calculer la valeur avec : ./scripts/scout-materiel.sh calibrer-hachage
PASSWORD_ITERATIONS=
# Durée des sessions (jours) : la connexion reste rare, ce qui compense un hachage plus léger
SESSION_DAYS=90

# --- Mémoire de la JVM (Pi) ---
# 128m convient pour un Pi 1 de 512 Mo ; 96m pour un Pi de 256 Mo
JVM_MAX_MEMORY=128m

# --- Adresse publique (Pi) ---
# Sous-domaine DuckDNS complet, ex. : scouts-xxx.duckdns.org (vide = HTTP sur le réseau local)
SITE_DOMAIN=
# true dès que SITE_DOMAIN est renseigné et que les ports 80/443 de la box sont redirigés
HTTPS=false
# Adresse utilisée dans les liens des e-mails ; vide = déduite de SITE_DOMAIN et HTTPS.
# Pour le premier test sur le réseau local, mettre l'IP du Pi : http://192.168.1.50
SITE_URL=

# --- Mise à jour (Pi) ---
# Jeton GitHub en lecture seule, seulement si le dépôt est privé (voir DEPLOIEMENT.md)
GITHUB_TOKEN=

# --- DuckDNS (accès Internet, Pi uniquement) ---
# Seulement le nom court, sans « .duckdns.org » : ex. scouts-xxx
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- Sauvegardes ---
# Heure de la sauvegarde quotidienne (envoyée par e-mail le dimanche) ; vide = désactivée
BACKUP_TIME=03:30

# --- E-mails ---
# console : les mails s'affichent dans le journal (développement)
# smtp    : envoi réel
EMAIL_BACKEND=console
# Exemple Gmail : activer la validation en 2 étapes sur le compte, puis créer un
# « mot de passe d'application » (https://myaccount.google.com/apppasswords)
# et le mettre dans EMAIL_HOST_PASSWORD (pas le mot de passe du compte).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Scout Matériel <adresse@gmail.com>"
# Adresse(s) qui reçoivent les nouvelles demandes et les sauvegardes, séparées par des virgules.
# Valeur par défaut : les adresses saisies dans Gestion › Réglages l'emportent.
ADMIN_EMAILS=
