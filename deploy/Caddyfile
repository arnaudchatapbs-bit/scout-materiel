# SITE_ADDRESS est calculé par docker-compose.yml à partir de SITE_DOMAIN (.env) :
#   SITE_DOMAIN vide            → « :80 » : HTTP simple sur le réseau local, pour un premier test.
#   SITE_DOMAIN=xxx.duckdns.org → HTTPS automatique (certificat Let's Encrypt).
#
# Caddy sert le front-end Angular (fichiers statiques, rien à calculer pour le Pi) et transmet
# /api/ à l'application Java, qui écoute seulement en local (127.0.0.1:8000).
{$SITE_ADDRESS} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$APP_PORT:8000} {
			# Le Pi 1 peut être lent au démarrage de la JVM
			transport http {
				response_header_timeout 120s
			}
		}
	}

	handle {
		root * /srv/frontend
		# Par défaut, toujours revalider (index.html, sw.js, manifeste) : les mises à jour arrivent tout de suite
		header Cache-Control "no-cache"
		# Fichiers dont le nom contient une empreinte (main-AB12CD34.js…) : en cache pour toujours
		@hashed path_regexp \-[A-Za-z0-9_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Application monopage : toute adresse inconnue renvoie index.html
		try_files {path} /index.html
		file_server
	}
}
